<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.canvas.Canvas?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.PieChart?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.demo.controller.MainController"
            styleClass="ana-ekran">
    <top>
        <VBox>
            <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
                <Text text="📦" style="-fx-font-size: 28px;"/>
                <VBox spacing="2">
                    <Label text="KargoNet" styleClass="header-title"/>
                    <Label text="Akilli Kargo Yonetim Sistemi - Java + Veri Yapilari" styleClass="header-sub"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="v1.0  |  HashMap - PriorityQueue - Stack - Graph - AVL-BST" styleClass="header-version"/>
            </HBox>
            <HBox fx:id="navBar" styleClass="navbar" alignment="CENTER_LEFT" spacing="4">
                <padding><Insets top="0" right="16" bottom="0" left="16"/></padding>
                <ToggleButton fx:id="btnDashboard" text="Dashboard" styleClass="nav-btn" selected="true" onAction="#onDashboard"/>
                <ToggleButton fx:id="btnGiris"     text="Kargo Kabul"  styleClass="nav-btn" onAction="#onGiris"/>
                <ToggleButton fx:id="btnKamyon"    text="Kamyonlar"    styleClass="nav-btn" onAction="#onKamyon"/>
                <ToggleButton fx:id="btnSorgulama" text="Sorgulama"    styleClass="nav-btn" onAction="#onSorgulama"/>
                <ToggleButton fx:id="btnRota"      text="Rota Haritasi" styleClass="nav-btn" onAction="#onRota"/>
                <ToggleButton fx:id="btnBst"       text="BST Liste"    styleClass="nav-btn" onAction="#onBst"/>
                <ToggleButton fx:id="btnRaporlar"  text="Raporlar"     styleClass="nav-btn" onAction="#onRaporlar"/>
                <ToggleButton fx:id="btnMusteriler" text="Musteriler"  styleClass="nav-btn" onAction="#onMusteriler"/>
                <ToggleButton fx:id="btnBakim"     text="Bakim"        styleClass="nav-btn" onAction="#onKamyonBakim"/>
                <ToggleButton fx:id="btnFaturalar" text="Faturalar"    styleClass="nav-btn" onAction="#onFaturalar"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="icerikAlani">

            <VBox fx:id="dashboardPanel" styleClass="panel" spacing="20">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                <Label text="Genel Bakis" styleClass="panel-baslik"/>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <VBox styleClass="stat-kart" prefWidth="180" alignment="CENTER_LEFT" spacing="6" style="-fx-border-color: #3b82f6; -fx-border-width: 0 0 0 4;">
                        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                        <Label text="Toplam Kargo" styleClass="stat-baslik"/>
                        <Label fx:id="lblToplamKargo" text="0" styleClass="stat-deger" style="-fx-text-fill: #3b82f6;"/>
                    </VBox>
                    <VBox styleClass="stat-kart" prefWidth="180" alignment="CENTER_LEFT" spacing="6" style="-fx-border-color: #f59e0b; -fx-border-width: 0 0 0 4;">
                        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                        <Label text="Depoda" styleClass="stat-baslik"/>
                        <Label fx:id="lblDepodaki" text="0" styleClass="stat-deger" style="-fx-text-fill: #f59e0b;"/>
                    </VBox>
                    <VBox styleClass="stat-kart" prefWidth="180" alignment="CENTER_LEFT" spacing="6" style="-fx-border-color: #8b5cf6; -fx-border-width: 0 0 0 4;">
                        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                        <Label text="Yolda" styleClass="stat-baslik"/>
                        <Label fx:id="lblYoldaki" text="0" styleClass="stat-deger" style="-fx-text-fill: #8b5cf6;"/>
                    </VBox>
                    <VBox styleClass="stat-kart" prefWidth="180" alignment="CENTER_LEFT" spacing="6" style="-fx-border-color: #10b981; -fx-border-width: 0 0 0 4;">
                        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                        <Label text="Teslim Edildi" styleClass="stat-baslik"/>
                        <Label fx:id="lblTeslim" text="0" styleClass="stat-deger" style="-fx-text-fill: #10b981;"/>
                    </VBox>
                    <VBox styleClass="stat-kart" prefWidth="180" alignment="CENTER_LEFT" spacing="6" style="-fx-border-color: #ef4444; -fx-border-width: 0 0 0 4;">
                        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                        <Label text="Kuyrukta" styleClass="stat-baslik"/>
                        <Label fx:id="lblBekleyen" text="0" styleClass="stat-deger" style="-fx-text-fill: #ef4444;"/>
                    </VBox>
                </HBox>
                <Label text="Son Kargolar" styleClass="section-baslik"/>
                <HBox styleClass="col-header" spacing="12" alignment="CENTER_LEFT">
                    <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
                    <Label text="ID" styleClass="col-baslik" prefWidth="95"/>
                    <Label text="Tip" styleClass="col-baslik" prefWidth="90"/>
                    <Label text="Gonderen - Alici" styleClass="col-baslik" HBox.hgrow="ALWAYS"/>
                    <Label text="Adres" styleClass="col-baslik" prefWidth="200"/>
                    <Label text="Agirlik" styleClass="col-baslik" prefWidth="70"/>
                    <Label text="Durum" styleClass="col-baslik" prefWidth="110"/>
                </HBox>
                <ScrollPane fx:id="kargoScrollPane" fitToWidth="true" prefHeight="400" styleClass="scroll-panel" VBox.vgrow="ALWAYS">
                    <VBox fx:id="kargoListBox" spacing="8">
                        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <VBox fx:id="kargoGirisPanel" visible="false" styleClass="panel" spacing="20">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                <Label text="Yeni Kargo Kaydi" styleClass="panel-baslik"/>
                <Label styleClass="info-text" wrapText="true" text="Kargo tipi NORMAL secilirse standart Queue'ya, digerleri (VIP/HIZLI/BOZULABILIR) Priority Queue'ya eklenir."/>
                <GridPane styleClass="form-grid" hgap="16" vgap="14" maxWidth="700">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <Label text="Gonderici:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="gonderenField" promptText="Ahmet Yilmaz" styleClass="form-field" prefWidth="320" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Alici:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="aliciField" promptText="Mehmet Demir" styleClass="form-field" prefWidth="320" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Adres:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="adresField" promptText="Kadikoy, Istanbul" styleClass="form-field" prefWidth="320" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Agirlik (kg):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="agirlikField" text="5.0" styleClass="form-field" prefWidth="320" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Hacim (m3):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="hacimField" text="0.3" styleClass="form-field" prefWidth="320" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <Label text="Tip:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <ComboBox fx:id="tipCombo" prefWidth="200" styleClass="form-combo" onAction="#onTipDegisti" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                    <Label text="" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                    <Label fx:id="tipAcikLabel" styleClass="tip-acik" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                </GridPane>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="Kargoyu Kaydet" styleClass="btn-primary" onAction="#onKaydet"/>
                    <Button text="Temizle" styleClass="btn-secondary" onAction="#onTemizle"/>
                </HBox>
                <Label fx:id="kargoGirisSonucLabel" styleClass="sonuc-label" wrapText="true" text=""/>
            </VBox>

            <VBox fx:id="kamyonPanel" visible="false" styleClass="panel" spacing="20">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                <Label text="Kamyon ve Stack Yonetimi" styleClass="panel-baslik"/>
                <Label styleClass="info-text" wrapText="true" text="Kargolar LIFO (Last In First Out) mantigiyla yuklenir. Rotada en son teslim edilecek kargo en alta yuklenir. Teslim islemi Stack'ten pop() ile yapilir."/>
                <Label fx:id="kamyonInfoLabel" styleClass="sonuc-label" wrapText="true" text=""/>
                <ScrollPane fx:id="kamyonScrollPane" fitToWidth="true" prefHeight="580" styleClass="scroll-panel" VBox.vgrow="ALWAYS">
                    <VBox fx:id="kamyonListBox" spacing="16">
                        <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <VBox fx:id="sorgulamaPanel" visible="false" styleClass="panel" spacing="20">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                <Label text="Kargo Sorgulama - HashMap O(1)" styleClass="panel-baslik"/>
                <Label styleClass="info-text" wrapText="true" text="Kargo ID girildiginde Hash Table uzerinden O(1) karmasikliginda anlik sonuc doner. Tum kargolari aramak yerine dogrudan hash degeriyle erisilir."/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="aramaField" promptText="Kargo ID girin (ornek: KRG1001)" styleClass="form-field" prefWidth="300" onAction="#onAra"/>
                    <Button text="Ara" styleClass="btn-primary" onAction="#onAra"/>
                    <Button text="Tum IDleri Goster" styleClass="btn-secondary" onAction="#onTumIdler"/>
                </HBox>
                <ScrollPane fx:id="sorgulamaScrollPane" fitToWidth="true" prefHeight="500" styleClass="scroll-panel" VBox.vgrow="ALWAYS">
                    <VBox fx:id="sorgulamaSonucBox" spacing="10">
                        <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <VBox fx:id="rotaPanel" visible="false" styleClass="panel" spacing="20">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                <Label text="Teslimat Rotasi - Dijkstra Algoritmasi" styleClass="panel-baslik"/>
                <Label styleClass="info-text" wrapText="true" text="Graf uzerindeki ilceler dugum (node), yollar ayrit (edge). Dijkstra algoritmasi ile baslangic ve hedef arasindaki en kisa yol hesaplanir."/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Baslangic:" styleClass="form-label"/>
                    <ComboBox fx:id="baslangicCombo" styleClass="form-combo" prefWidth="160"/>
                    <Label text="Hedef:" styleClass="form-label"/>
                    <ComboBox fx:id="hedefCombo" styleClass="form-combo" prefWidth="160"/>
                    <Button text="Rotayi Hesapla (Dijkstra)" styleClass="btn-primary" onAction="#onHesapla"/>
                </HBox>
                <Label fx:id="rotaSonucLabel" styleClass="sonuc-label" wrapText="true" text=""/>
                <StackPane styleClass="graf-canvas" VBox.vgrow="ALWAYS">
                    <Canvas fx:id="grafCanvas" width="750" height="430"/>
                </StackPane>
            </VBox>

            <VBox fx:id="bstPanel" visible="false" styleClass="panel" spacing="20">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                <Label text="Sirali Kargo Listesi - AVL BST (In-Order Traversal)" styleClass="panel-baslik"/>
                <Label styleClass="info-text" wrapText="true" text="Kargolar AVL Agaci (dengeli BST) yapisinda tutulur. In-order traversal (sol, kok, sag) ile alici adina gore alfabetik sirali liste elde edilir. Her ekleme O(log n) karmasikliginda yapilir."/>
                <Button text="Listeyi Yenile" styleClass="btn-secondary" onAction="#onYenile"/>
                <HBox styleClass="col-header" spacing="12" alignment="CENTER_LEFT">
                    <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
                    <Label text="#" styleClass="col-baslik" prefWidth="50"/>
                    <Label text="ID" styleClass="col-baslik" prefWidth="95"/>
                    <Label text="Alici" styleClass="col-baslik" prefWidth="170"/>
                    <Label text="Gonderici" styleClass="col-baslik" prefWidth="160"/>
                    <Label text="Tip" styleClass="col-baslik" prefWidth="90"/>
                    <Label text="Adres" styleClass="col-baslik" prefWidth="200"/>
                    <Label text="Agirlik" styleClass="col-baslik" prefWidth="75"/>
                    <Label text="Durum" styleClass="col-baslik" prefWidth="110"/>
                </HBox>
                <ScrollPane fx:id="bstScrollPane" fitToWidth="true" prefHeight="540" styleClass="scroll-panel" VBox.vgrow="ALWAYS">
                    <VBox fx:id="bstListeBox" spacing="4">
                        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ===== RAPORLAR PANELİ ===== -->
            <VBox fx:id="raporlarPanel" visible="false" styleClass="panel" spacing="20">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                <Label text="Kargo Raporlari ve Istatistikler" styleClass="panel-baslik"/>
                <Label styleClass="info-text" wrapText="true" text="Gunluk/haftalik/aylik kargo giris grafikleri, teslimat sure dagilimi ve yogun bolgeler."/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <ComboBox fx:id="raporPeriyotCombo" styleClass="form-combo" prefWidth="200"/>
                    <Button text="Grafigi Guncelle" styleClass="btn-primary" onAction="#onRaporGuncelle"/>
                    <Button text="Excel'e Aktar" styleClass="btn-secondary" onAction="#onExcelAktar"/>
                </HBox>
                <TabPane fx:id="raporTabPane" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="Kargo Giris Grafigi" closable="false">
                            <VBox spacing="10" style="-fx-padding:10;">
                                <BarChart fx:id="raporBarChart" animated="false" prefHeight="350">
                                    <xAxis><javafx.scene.chart.CategoryAxis/></xAxis>
                                    <yAxis><javafx.scene.chart.NumberAxis/></yAxis>
                                </BarChart>
                            </VBox>
                        </Tab>
                        <Tab text="Teslimat Sureleri" closable="false">
                            <VBox spacing="10" style="-fx-padding:10;">
                                <PieChart fx:id="raporPieChart" animated="false" prefHeight="350"/>
                            </VBox>
                        </Tab>
                        <Tab text="Yogun Bolgeler" closable="false">
                            <VBox spacing="10" style="-fx-padding:10;">
                                <BarChart fx:id="raporBolgeChart" animated="false" prefHeight="350">
                                    <xAxis><javafx.scene.chart.CategoryAxis/></xAxis>
                                    <yAxis><javafx.scene.chart.NumberAxis/></yAxis>
                                </BarChart>
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>
            </VBox>

            <!-- ===== MÜŞTERİLER PANELİ ===== -->
            <VBox fx:id="musterilerPanel" visible="false" styleClass="panel" spacing="20">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                <Label text="Musteri Yonetimi" styleClass="panel-baslik"/>
                <Label styleClass="info-text" wrapText="true" text="Kayitli musterilerin listesi ve detay bilgileri."/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="Listeyi Yenile" styleClass="btn-primary" onAction="#onMusterileriYenile"/>
                </HBox>
                <ScrollPane fitToWidth="true" prefHeight="550" styleClass="scroll-panel" VBox.vgrow="ALWAYS">
                    <VBox fx:id="musteriListBox" spacing="8">
                        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ===== BAKIM PANELİ ===== -->
            <VBox fx:id="bakimPanel" visible="false" styleClass="panel" spacing="20">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                <Label text="Kamyon Bakim Kayitlari" styleClass="panel-baslik"/>
                <Label styleClass="info-text" wrapText="true" text="Kamyon secip bakim gecmisini goruntuleyebilirsiniz."/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <ComboBox fx:id="bakimKamyonCombo" styleClass="form-combo" prefWidth="200" promptText="Kamyon secin"/>
                    <Button text="Kayitlari Getir" styleClass="btn-primary" onAction="#onBakimGetir"/>
                </HBox>
                <ScrollPane fitToWidth="true" prefHeight="520" styleClass="scroll-panel" VBox.vgrow="ALWAYS">
                    <VBox fx:id="bakimListBox" spacing="8">
                        <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ===== FATURALAR PANELİ ===== -->
            <VBox fx:id="faturalarPanel" visible="false" styleClass="panel" spacing="20">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
                <Label text="Fatura Yonetimi" styleClass="panel-baslik"/>
                <Label styleClass="info-text" wrapText="true" text="Kargo ID girerek fatura detaylarini sorgulayabilirsiniz."/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="faturaKargoIdField" promptText="Kargo ID (ornek: KRG1001)" styleClass="form-field" prefWidth="300"/>
                    <Button text="Sorgula" styleClass="btn-primary" onAction="#onFaturaSorgula"/>
                </HBox>
                <Label fx:id="faturaLabel" styleClass="sonuc-label" wrapText="true" text=""/>
                <ScrollPane fitToWidth="true" prefHeight="480" styleClass="scroll-panel" VBox.vgrow="ALWAYS">
                    <VBox fx:id="faturaDetayBox" spacing="10">
                        <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    </VBox>
                </ScrollPane>
            </VBox>

        </StackPane>
    </center>
</BorderPane>